generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Parish {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String   @db.VarChar(255)
  slug                String?  @unique @db.VarChar(255)
  phone               String   @db.VarChar(255)
  document            String?  @db.VarChar(255)
  priest              String?  @db.VarChar(255)
  themePrimaryColor   String?  @map("theme_primary_color") @db.VarChar(255)
  themeSecondaryColor String?  @map("theme_secondary_color") @db.VarChar(255)
  logoUrl             String?  @map("logo_url") @db.VarChar(255)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  returns             Return[]
  tithers             Tither[]
  users               User[]

  @@map("parishes")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  parishId  String?  @map("parish_id") @db.Uuid
  phone     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  role      Role     @default(TITHER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  returns   Return[]
  tither    Tither?
  parish    Parish?  @relation(fields: [parishId], references: [id])

  @@map("users")
}

model Tither {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @unique @map("user_id") @db.Uuid
  parishId       String      @map("parish_id") @db.Uuid
  name           String      @db.VarChar(255)
  phoneSecondary String?     @map("phone_secondary") @db.VarChar(255)
  birthDate      DateTime    @map("birth_date") @db.Date
  ministry       String?     @db.VarChar(255)
  civilStatus    CivilStatus @map("civil_status")
  spouseName     String?     @map("spouse_name") @db.VarChar(255)
  marriageDate   DateTime?   @map("marriage_date") @db.Date
  community      String?     @db.VarChar(255)
  street         String?     @db.VarChar(255)
  neighborhood   String?     @db.VarChar(255)
  city           String?     @db.VarChar(255)
  state          String?     @db.VarChar(255)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamp(6)
  parish         Parish      @relation(fields: [parishId], references: [id])
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tithers")
}

model Return {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  parishId       String         @map("parish_id") @db.Uuid
  value          Int            @map("value")
  referenceMonth Int            @map("reference_month")
  referenceYear  Int            @map("reference_year")
  status         ReturnStatus   @default(PENDING)
  paymentMethod  PaymentMethod? @map("payment_method")
  paidAt         DateTime?      @map("paid_at") @db.Timestamp(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  parish         Parish         @relation(fields: [parishId], references: [id])
  user           User           @relation(fields: [userId], references: [id])

  @@unique([userId, parishId, referenceMonth, referenceYear])
  @@map("returns")
}

enum Role {
  SUPER_ADMIN
  PARISH_ADMIN
  TITHER
}

enum CivilStatus {
  SINGLE
  MARRIED
  WIDOWED
  OTHER
}

enum ReturnStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  CASH
  PAYMENT_TICKET
}
